import mongoose from "mongoose";

import ProjectUpdate from "../models/ProjectUpdate.js";
import Project from "../models/Project.js";
import Stage from "../models/Stage.js";
import Activity from "../models/Activity.js";

// ============================================================
// HELPERS
// ============================================================

const isValidObjectId = (id) => {
  return mongoose.Types.ObjectId.isValid(id);
};

// ============================================================
// CREATE PROJECT UPDATE
// ============================================================

export const createProjectUpdate = async (req, res) => {
  try {
    const {
      project,
      stage,
      activity,
      updateDate,
      title,
      description,
      progressBefore,
      progressAfter,
      status,
      issues,
      actionsRequired,
      reportedBy,
      organisation,
      notes,
    } = req.body;

    // --------------------------------------------------------
    // Validate project
    // --------------------------------------------------------

    if (!project || !isValidObjectId(project)) {
      return res.status(400).json({
        success: false,
        message: "A valid project is required",
      });
    }

    const projectExists = await Project.findById(project);

    if (!projectExists) {
      return res.status(404).json({
        success: false,
        message: "Project not found",
      });
    }

    // --------------------------------------------------------
    // Validate stage if supplied
    // --------------------------------------------------------

    if (stage) {
      if (!isValidObjectId(stage)) {
        return res.status(400).json({
          success: false,
          message: "Invalid stage ID",
        });
      }

      const stageExists = await Stage.findOne({
        _id: stage,
        project,
      });

      if (!stageExists) {
        return res.status(400).json({
          success: false,
          message: "The selected stage does not belong to this project",
        });
      }
    }

    // --------------------------------------------------------
    // Validate activity if supplied
    // --------------------------------------------------------

    if (activity) {
      if (!isValidObjectId(activity)) {
        return res.status(400).json({
          success: false,
          message: "Invalid activity ID",
        });
      }

      const activityExists = await Activity.findOne({
        _id: activity,
        project,
      });

      if (!activityExists) {
        return res.status(400).json({
          success: false,
          message:
            "The selected activity does not belong to this project",
        });
      }

      // If both stage and activity are supplied,
      // make sure the activity belongs to that stage.
      if (stage && activityExists.stage.toString() !== stage.toString()) {
        return res.status(400).json({
          success: false,
          message:
            "The selected activity does not belong to the selected stage",
        });
      }
    }

    // --------------------------------------------------------
    // Validate progress values
    // --------------------------------------------------------

    if (
      progressBefore !== undefined &&
      progressBefore !== null &&
      (Number(progressBefore) < 0 || Number(progressBefore) > 100)
    ) {
      return res.status(400).json({
        success: false,
        message: "Progress before must be between 0 and 100",
      });
    }

    if (
      progressAfter !== undefined &&
      progressAfter !== null &&
      (Number(progressAfter) < 0 || Number(progressAfter) > 100)
    ) {
      return res.status(400).json({
        success: false,
        message: "Progress after must be between 0 and 100",
      });
    }

    // --------------------------------------------------------
    // Validate reporter
    // --------------------------------------------------------

    if (!reportedBy || !isValidObjectId(reportedBy)) {
      return res.status(400).json({
        success: false,
        message: "A valid reporting user is required",
      });
    }

    // --------------------------------------------------------
    // Create update
    // --------------------------------------------------------

    const projectUpdate = await ProjectUpdate.create({
      project,
      stage: stage || null,
      activity: activity || null,
      updateDate: updateDate || new Date(),
      title,
      description,
      progressBefore,
      progressAfter,
      status: status || "On Track",
      issues: Array.isArray(issues) ? issues : [],
      actionsRequired: Array.isArray(actionsRequired)
        ? actionsRequired
        : [],
      reportedBy,
      organisation: organisation || null,
      notes: notes || "",
    });

    // --------------------------------------------------------
    // Return populated update
    // --------------------------------------------------------

    const populatedUpdate = await ProjectUpdate.findById(
      projectUpdate._id
    )
      .populate("project")
      .populate("stage")
      .populate("activity")
      .populate("reportedBy")
      .populate("organisation");

    res.status(201).json({
      success: true,
      message: "Project update created successfully",
      data: populatedUpdate,
    });
  } catch (error) {
    console.error("Create project update error:", error);

    res.status(400).json({
      success: false,
      message: "Failed to create project update",
      error: error.message,
    });
  }
};

// ============================================================
// GET ALL PROJECT UPDATES
// ============================================================

export const getProjectUpdates = async (req, res) => {
  try {
    const { projectId } = req.params;

    if (!isValidObjectId(projectId)) {
      return res.status(400).json({
        success: false,
        message: "Invalid project ID",
      });
    }

    const updates = await ProjectUpdate.find({
      project: projectId,
    })
      .populate("stage")
      .populate("activity")
      .populate("reportedBy")
      .populate("organisation")
      .sort({
        updateDate: -1,
        createdAt: -1,
      });

    res.status(200).json({
      success: true,
      count: updates.length,
      data: updates,
    });
  } catch (error) {
    console.error("Get project updates error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to retrieve project updates",
      error: error.message,
    });
  }
};

