---
interface Props {
  heading: string;
  activeActivities: number;
  activeStages: number;
  animation: string;
}

const {
  heading,
  activeActivities,
  activeStages,
  animation
} = Astro.props;
---

<div class="stat-card">

  <div class="stat-card-content">
    <h3>{heading}</h3>

    <div class="stat-card-numbers">
      <div>
        <span class="number">{activeActivities}</span>
        <span class="label">Activities</span>
      </div>

      <div>
        <span class="number">{activeStages}</span>
        <span class="label">Stages</span>
      </div>
    </div>
  </div>
  <div class="stat-card-icon">
    <lottie-player
      src={animation}
      background="transparent"
      speed="1"
      loop
      autoplay>
    </lottie-player>
  </div>
</div>

<style>
  .stat-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 1rem;
    border-radius: 12px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .stat-card-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }

  .stat-card-icon lottie-player {
    width: 100%;
    height: 100%;
  }

  .stat-card-content {
    flex: 1;
  }

  .stat-card-content h3 {
    margin: 0 0 10px;
  }

  .stat-card-numbers {
    display: flex;
    gap: 25px;
  }

  .number {
    display: block;
    font-size: 24px;
    font-weight: 600;
  }

  .label {
    font-size: 12px;
  }
</style>