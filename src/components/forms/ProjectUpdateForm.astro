// ============================================================
// UPDATE PROJECT UPDATE
// ============================================================

export const updateProjectUpdate = async (req, res) => {
  try {
    const { id } = req.params;

    if (!isValidObjectId(id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid project update ID",
      });
    }

    const existingUpdate = await ProjectUpdate.findById(id);

    if (!existingUpdate) {
      return res.status(404).json({
        success: false,
        message: "Project update not found",
      });
    }

    const {
      project,
      stage,
      activity,
      updateDate,
      title,
      description,
      progressBefore,
      progressAfter,
      status,
      issues,
      actionsRequired,
      reportedBy,
      organisation,
      notes,
    } = req.body;

    // --------------------------------------------------------
    // Prevent changing project relationship
    // --------------------------------------------------------

    if (
      project &&
      project.toString() !== existingUpdate.project.toString()
    ) {
      return res.status(400).json({
        success: false,
        message: "The project associated with an update cannot be changed",
      });
    }

    const projectId = existingUpdate.project;

    // --------------------------------------------------------
    // Validate stage
    // --------------------------------------------------------

    if (stage) {
      if (!isValidObjectId(stage)) {
        return res.status(400).json({
          success: false,
          message: "Invalid stage ID",
        });
      }

      const stageExists = await Stage.findOne({
        _id: stage,
        project: projectId,
      });

      if (!stageExists) {
        return res.status(400).json({
          success: false,
          message:
            "The selected stage does not belong to this project",
        });
      }
    }

    // --------------------------------------------------------
    // Validate activity
    // --------------------------------------------------------

    if (activity) {
      if (!isValidObjectId(activity)) {
        return res.status(400).json({
          success: false,
          message: "Invalid activity ID",
        });
      }

      const activityExists = await Activity.findOne({
        _id: activity,
        project: projectId,
      });

      if (!activityExists) {
        return res.status(400).json({
          success: false,
          message:
            "The selected activity does not belong to this project",
        });
      }

      const selectedStage = stage || existingUpdate.stage;

      if (
        selectedStage &&
        activityExists.stage.toString() !== selectedStage.toString()
      ) {
        return res.status(400).json({
          success: false,
          message:
            "The selected activity does not belong to the selected stage",
        });
      }
    }

    // --------------------------------------------------------
    // Validate progress
    // --------------------------------------------------------

    if (
      progressBefore !== undefined &&
      progressBefore !== null &&
      (Number(progressBefore) < 0 || Number(progressBefore) > 100)
    ) {
      return res.status(400).json({
        success: false,
        message: "Progress before must be between 0 and 100",
      });
    }

    if (
      progressAfter !== undefined &&
      progressAfter !== null &&
      (Number(progressAfter) < 0 || Number(progressAfter) > 100)
    ) {
      return res.status(400).json({
        success: false,
        message: "Progress after must be between 0 and 100",
      });
    }

    // --------------------------------------------------------
    // Update allowed fields only
    // --------------------------------------------------------

    existingUpdate.stage =
      stage !== undefined ? stage || null : existingUpdate.stage;

    existingUpdate.activity =
      activity !== undefined
        ? activity || null
        : existingUpdate.activity;

    if (updateDate !== undefined) {
      existingUpdate.updateDate = updateDate;
    }

    if (title !== undefined) {
      existingUpdate.title = title;
    }

    if (description !== undefined) {
      existingUpdate.description = description;
    }

    if (progressBefore !== undefined) {
      existingUpdate.progressBefore =
        progressBefore === "" ? undefined : progressBefore;
    }

    if (progressAfter !== undefined) {
      existingUpdate.progressAfter =
        progressAfter === "" ? undefined : progressAfter;
    }

    if (status !== undefined) {
      existingUpdate.status = status;
    }

    if (issues !== undefined) {
      existingUpdate.issues = Array.isArray(issues) ? issues : [];
    }

    if (actionsRequired !== undefined) {
      existingUpdate.actionsRequired = Array.isArray(actionsRequired)
        ? actionsRequired
        : [];
    }

    if (reportedBy !== undefined) {
      if (!isValidObjectId(reportedBy)) {
        return res.status(400).json({
          success: false,
          message: "Invalid reporting user ID",
        });
      }

      existingUpdate.reportedBy = reportedBy;
    }

    if (organisation !== undefined) {
      existingUpdate.organisation = organisation || null;
    }

    if (notes !== undefined) {
      existingUpdate.notes = notes;
    }

    await existingUpdate.save();

    const populatedUpdate = await ProjectUpdate.findById(
      existingUpdate._id
    )
      .populate("project")
      .populate("stage")
      .populate("activity")
      .populate("reportedBy")
      .populate("organisation");

    res.status(200).json({
      success: true,
      message: "Project update updated successfully",
      data: populatedUpdate,
    });
  } catch (error) {
    console.error("Update project update error:", error);

    res.status(400).json({
      success: false,
      message: "Failed to update project update",
      error: error.message,
    });
  }
};

// ============================================================
// DELETE PROJECT UPDATE
// ============================================================

export const deleteProjectUpdate = async (req, res) => {
  try {
    const { id } = req.params;

    if (!isValidObjectId(id)) {
      return res.status(400).json({
        success: false,
        message: "Invalid project update ID",
      });
    }

    const update = await ProjectUpdate.findByIdAndDelete(id);

    if (!update) {
      return res.status(404).json({
        success: false,
        message: "Project update not found",
      });
    }

    res.status(200).json({
      success: true,
      message: "Project update deleted successfully",
    });
  } catch (error) {
    console.error("Delete project update error:", error);

    res.status(500).json({
      success: false,
      message: "Failed to delete project update",
      error: error.message,
    });
  }
};