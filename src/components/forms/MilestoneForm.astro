---
const { projectId } = Astro.props;
---

<section class="milestone-form-card">

  <!-- HEADER -->
  <div class="milestone-form-header">

    <div class="milestone-form-heading">

      <span class="milestone-form-eyebrow">
        Milestone Management
      </span>

      <h2 id="milestoneFormTitle">
        Create Milestone
      </h2>

      <p id="milestoneFormDescription">
        Create a new milestone and associate it with a stage and activity.
      </p>

    </div>


    <div class="milestone-mode-toggle">

      <button
        type="button"
        class="milestone-mode-button active"
        data-mode="create"
      >
        Create
      </button>

      <button
        type="button"
        class="milestone-mode-button"
        data-mode="edit"
      >
        Edit
      </button>

    </div>

  </div>


  <!-- EDIT MILESTONE SELECTOR -->
  <div
    id="editMilestoneContainer"
    class="form-section edit-milestone-section"
    hidden
  >

    <div class="section-heading">

      <h3>
        Select Milestone
      </h3>

      <p>
        Select an existing milestone to edit its details.
      </p>

    </div>


    <div class="form-group">

      <label for="editMilestoneSelect">
        Milestone
      </label>

      <select id="editMilestoneSelect">

        <option value="">
          Loading milestones...
        </option>

      </select>

    </div>

  </div>


  <form id="milestoneForm">

    <!-- GENERAL INFORMATION -->
    <div class="form-section">

      <div class="section-heading">

        <h3>
          General Information
        </h3>

        <p>
          Basic information about the milestone.
        </p>

      </div>


      <div class="form-grid">

        <div class="form-group form-group-full">

          <label for="name">

            Milestone Name

            <span class="required">
              *
            </span>

          </label>


          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter milestone name"
            required
          />

        </div>


        <div class="form-group">

          <label for="milestoneCode">
            Milestone Code
          </label>


          <input
            type="text"
            id="milestoneCode"
            name="milestoneCode"
            placeholder="e.g. MS-001"
          />


          <small class="field-help">
            The milestone code will automatically be converted to uppercase.
          </small>

        </div>


        <div class="form-group">

          <label for="importance">
            Importance
          </label>


          <select
            id="importance"
            name="importance"
          >

            <option value="Low">
              Low
            </option>

            <option value="Medium" selected>
              Medium
            </option>

            <option value="High">
              High
            </option>

            <option value="Critical">
              Critical
            </option>

          </select>

        </div>


        <div class="form-group form-group-full">

          <label for="description">
            Description
          </label>


          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Describe the milestone..."
          ></textarea>

        </div>

      </div>

    </div>


    <!-- HIERARCHY -->
    <div class="form-section">

      <div class="section-heading">

        <h3>
          Project Hierarchy
        </h3>

        <p>
          Associate the milestone with a stage and, optionally, an activity.
        </p>

      </div>


      <div class="form-grid">

        <div class="form-group">

          <label for="stage">

            Stage / Substage

            <span class="required">
              *
            </span>

          </label>


          <select
            id="stage"
            name="stage"
            required
          >

            <option value="">
              Loading stages...
            </option>

          </select>


          <small class="field-help">
            Select the stage or substage to which this milestone belongs.
          </small>

        </div>


        <div class="form-group">

          <label for="activity">
            Activity
          </label>


          <select
            id="activity"
            name="activity"
          >

            <option value="">
              No Activity
            </option>

          </select>


          <small class="field-help">
            Optionally associate the milestone with an activity within the selected stage.
          </small>

        </div>

      </div>

    </div>


    <!-- DATES & STATUS -->
    <div class="form-section">

      <div class="section-heading">

        <h3>
          Schedule & Status
        </h3>

        <p>
          Define when the milestone is planned and track its achievement.
        </p>

      </div>


      <div class="form-grid">

        <div class="form-group">

          <label for="plannedDate">

            Planned Date

            <span class="required">
              *
            </span>

          </label>


          <input
            type="date"
            id="plannedDate"
            name="plannedDate"
            required
          />


          <small class="field-help">
            The date on which the milestone is planned to occur.
          </small>

        </div>


        <div class="form-group">

          <label for="actualDate">
            Actual Date
          </label>


          <input
            type="date"
            id="actualDate"
            name="actualDate"
          />


          <small class="field-help">
            Enter the actual achievement date once the milestone occurs.
          </small>

        </div>


        <div class="form-group">

          <label for="status">
            Status
          </label>


          <select
            id="status"
            name="status"
          >

            <option value="Pending">
              Pending
            </option>

            <option value="Achieved">
              Achieved
            </option>

            <option value="Delayed">
              Delayed
            </option>

            <option value="Cancelled">
              Cancelled
            </option>

          </select>

        </div>


        <div class="form-group">

          <label for="isActive">
            Activity Status
          </label>


          <label class="checkbox-label">

            <input
              type="checkbox"
              id="isActive"
              name="isActive"
              checked
            />

            <span>
              Milestone is active
            </span>

          </label>

        </div>

      </div>

    </div>


    <!-- NOTES -->
    <div class="form-section">

      <div class="section-heading">

        <h3>
          Notes
        </h3>

        <p>
          Add any additional information relating to the milestone.
        </p>

      </div>


      <div class="form-group">

        <label for="notes">
          Notes
        </label>


        <textarea
          id="notes"
          name="notes"
          rows="4"
          placeholder="Additional notes..."
        ></textarea>

      </div>

    </div>


    <!-- ACTIONS -->
    <div class="form-actions">

      <button
        type="button"
        id="resetMilestoneForm"
        class="secondary-button"
      >
        Reset
      </button>


      <button
        type="submit"
        id="submitMilestoneButton"
        class="primary-button"
      >
        Create Milestone
      </button>

    </div>

  </form>


  <div
    id="milestoneFormMessage"
    class="form-message"
    role="status"
    aria-live="polite"
  ></div>

</section>


<script define:vars={{ projectId }}>

  const API_BASE =
    "http://localhost:5000/api";


  /*
   * =========================================================
   * STATE
   * =========================================================
   */

  let currentMode =
    "create";

  let currentMilestoneId =
    null;

  let stages = [];

  let allActivities = [];

  let stageActivities = [];

  let milestones = [];

  let loadingMilestone =
    false;


  /*
   * =========================================================
   * DOM REFERENCES
   * =========================================================
   */

  const form =
    document.getElementById(
      "milestoneForm"
    );


  const nameInput =
    document.getElementById(
      "name"
    );


  const descriptionInput =
    document.getElementById(
      "description"
    );


  const milestoneCodeInput =
    document.getElementById(
      "milestoneCode"
    );


  const importanceSelect =
    document.getElementById(
      "importance"
    );


  const stageSelect =
    document.getElementById(
      "stage"
    );


  const activitySelect =
    document.getElementById(
      "activity"
    );


  const plannedDateInput =
    document.getElementById(
      "plannedDate"
    );


  const actualDateInput =
    document.getElementById(
      "actualDate"
    );


  const statusSelect =
    document.getElementById(
      "status"
    );


  const isActiveInput =
    document.getElementById(
      "isActive"
    );


  const notesInput =
    document.getElementById(
      "notes"
    );


  const editMilestoneContainer =
    document.getElementById(
      "editMilestoneContainer"
    );


  const editMilestoneSelect =
    document.getElementById(
      "editMilestoneSelect"
    );


  const submitButton =
    document.getElementById(
      "submitMilestoneButton"
    );


  const resetButton =
    document.getElementById(
      "resetMilestoneForm"
    );


  const formMessage =
    document.getElementById(
      "milestoneFormMessage"
    );


  const formTitle =
    document.getElementById(
      "milestoneFormTitle"
    );


  const formDescription =
    document.getElementById(
      "milestoneFormDescription"
    );


  const modeButtons =
    document.querySelectorAll(
      ".milestone-mode-button"
    );


  /*
   * =========================================================
   * HELPERS
   * =========================================================
   */

  function getId(value) {

    if (!value) {
      return "";
    }


    if (
      typeof value ===
      "string"
    ) {

      return value;

    }


    if (
      typeof value ===
      "object"
    ) {

      return (
        value._id ||
        value.id ||
        ""
      );

    }


    return String(value);

  }


  function dateInputValue(
    value
  ) {

    if (!value) {
      return "";
    }


    const date =
      new Date(value);


    if (
      Number.isNaN(
        date.getTime()
      )
    ) {

      return "";

    }


    return date
      .toISOString()
      .slice(0, 10);

  }


  function showMessage(
    message,
    type = ""
  ) {

    formMessage.textContent =
      message;


    formMessage.className =
      `form-message ${type}`;

  }


  function clearMessage() {

    formMessage.textContent =
      "";


    formMessage.className =
      "form-message";

  }


  async function apiRequest(
    url,
    options = {}
  ) {

    const response =
      await fetch(
        url,
        {
          headers: {
            "Content-Type":
              "application/json",

            ...(options.headers || {})
          },

          ...options
        }
      );


    let data =
      null;


    try {

      data =
        await response.json();

    } catch {

      data =
        null;

    }


    if (
      !response.ok
    ) {

      throw new Error(
        data?.message ||
        data?.error ||
        "Request failed."
      );

    }


    return data;

  }


  /*
   * =========================================================
   * LOAD STAGES
   * =========================================================
   */

  async function loadStages() {

    const response =
      await apiRequest(
        `${API_BASE}/stages/project/${projectId}`
      );


    const topLevelStages =
      Array.isArray(response)
        ? response
        : (
            response?.stages ||
            response?.data ||
            []
          );


    const stageMap =
      new Map();


    topLevelStages.forEach(
      stage => {

        const id =
          getId(stage);


        if (id) {

          stageMap.set(
            id,
            stage
          );

        }

      }
    );


    /*
     * Recursively load substages.
     */

    async function loadChildren(
      parentStage
    ) {

      const parentId =
        getId(parentStage);


      if (!parentId) {
        return;
      }


      try {

        const response =
          await apiRequest(
            `${API_BASE}/stages/${parentId}/substages`
          );


        const children =
          Array.isArray(response)
            ? response
            : (
                response?.substages ||
                response?.stages ||
                response?.data ||
                []
              );


        for (
          const child of children
        ) {

          const childId =
            getId(child);


          if (!childId) {
            continue;
          }


          if (
            !stageMap.has(
              childId
            )
          ) {

            stageMap.set(
              childId,
              child
            );

          }


          await loadChildren(
            child
          );

        }

      } catch (error) {

        console.error(
          `Failed to load substages for ${parentId}`,
          error
        );

      }

    }


    await Promise.all(
      topLevelStages.map(
        stage =>
          loadChildren(stage)
      )
    );


    stages =
      Array.from(
        stageMap.values()
      );


    renderStageOptions();

  }


  /*
   * =========================================================
   * BUILD STAGE TREE
   * =========================================================
   */

  function buildStageChildrenMap() {

    const children =
      new Map();


    stages.forEach(
      stage => {

        const parentId =
          getId(
            stage.parentStage
          );


        if (
          !children.has(
            parentId
          )
        ) {

          children.set(
            parentId,
            []
          );

        }


        children
          .get(parentId)
          .push(stage);

      }
    );


    children.forEach(
      stageList => {

        stageList.sort(
          (a, b) =>
            (
              Number(
                a.sortOrder
              ) || 0
            ) -
            (
              Number(
                b.sortOrder
              ) || 0
            )
        );

      }
    );


    return children;

  }


  /*
   * =========================================================
   * RENDER STAGES
   * =========================================================
   */

  function renderStageOptions(
    selectedId = ""
  ) {

    stageSelect.innerHTML =
      "";


    const defaultOption =
      document.createElement(
        "option"
      );


    defaultOption.value =
      "";


    defaultOption.textContent =
      "Select stage / substage...";


    stageSelect.appendChild(
      defaultOption
    );


    const children =
      buildStageChildrenMap();


    function addStages(
      parentId = "",
      depth = 0
    ) {

      const childStages =
        children.get(
          parentId
        ) || [];


      childStages.forEach(
        stage => {

          const option =
            document.createElement(
              "option"
            );


          const stageId =
            getId(stage);


          option.value =
            stageId;


          const prefix =
            depth > 0
              ? `${"— ".repeat(depth)}`
              : "";


          const code =
            stage.code
              ? `${stage.code} — `
              : "";


          option.textContent =
            `${prefix}${code}${stage.name}`;


          option.selected =
            stageId === selectedId;


          stageSelect.appendChild(
            option
          );


          addStages(
            stageId,
            depth + 1
          );

        }
      );

    }


    addStages();

  }


  /*
   * =========================================================
   * LOAD STAGE ACTIVITIES
   * =========================================================
   */

  async function loadStageActivities(
    stageId,
    selectedActivityId = ""
  ) {

    activitySelect.innerHTML =
      "";


    const noneOption =
      document.createElement(
        "option"
      );


    noneOption.value =
      "";


    noneOption.textContent =
      "No Activity";


    activitySelect.appendChild(
      noneOption
    );


    if (!stageId) {

      stageActivities =
        [];

      return;

    }


    const loadingOption =
      document.createElement(
        "option"
      );


    loadingOption.value =
      "";


    loadingOption.textContent =
      "Loading activities...";


    activitySelect.appendChild(
      loadingOption
    );


    try {

      const response =
        await apiRequest(
          `${API_BASE}/activities/stage/${stageId}`
        );


      stageActivities =
        Array.isArray(response)
          ? response
          : (
              response?.activities ||
              response?.data ||
              []
            );


      renderActivityOptions(
        selectedActivityId
      );


    } catch (error) {

      console.error(
        "Failed to load stage activities:",
        error
      );


      stageActivities =
        [];


      activitySelect.innerHTML =
        "";


      const option =
        document.createElement(
          "option"
        );


      option.value =
        "";


      option.textContent =
        "No Activity";


      activitySelect.appendChild(
        option
      );

    }

  }


  /*
   * =========================================================
   * RENDER ACTIVITIES
   * =========================================================
   */

  function renderActivityOptions(
    selectedId = ""
  ) {

    activitySelect.innerHTML =
      "";


    const noneOption =
      document.createElement(
        "option"
      );


    noneOption.value =
      "";


    noneOption.textContent =
      "No Activity";


    activitySelect.appendChild(
      noneOption
    );


    const availableActivities =
      stageActivities.filter(
        activity =>
          getId(activity) !==
          currentMilestoneActivityId()
      );


    availableActivities.sort(
      (a, b) =>
        (
          Number(
            a.sequence
          ) || 0
        ) -
        (
          Number(
            b.sequence
          ) || 0
        )
    );


    availableActivities.forEach(
      activity => {

        const option =
          document.createElement(
            "option"
          );


        const activityId =
          getId(activity);


        option.value =
          activityId;


        const code =
          activity.activityCode
            ? `${activity.activityCode} — `
            : "";


        option.textContent =
          `${code}${activity.name}`;


        option.selected =
          activityId ===
          selectedId;


        activitySelect.appendChild(
          option
        );

      }
    );

  }


  /*
   * This exists so the activity
   * renderer remains independent
   * of the milestone object.
   */

  function currentMilestoneActivityId() {

    return "";

  }


  /*
   * =========================================================
   * LOAD PROJECT MILESTONES
   * =========================================================
   */

  async function loadMilestones() {

    const response =
      await apiRequest(
        `${API_BASE}/milestones/project/${projectId}`
      );


    milestones =
      Array.isArray(response)
        ? response
        : (
            response?.milestones ||
            response?.data ||
            []
          );


    renderEditMilestoneOptions();

  }


  /*
   * =========================================================
   * RENDER EDIT MILESTONES
   * =========================================================
   */

  function renderEditMilestoneOptions() {

    editMilestoneSelect.innerHTML =
      "";


    const defaultOption =
      document.createElement(
        "option"
      );


    defaultOption.value =
      "";


    defaultOption.textContent =
      "Select a milestone...";


    editMilestoneSelect.appendChild(
      defaultOption
    );


    const groups =
      new Map();


    milestones.forEach(
      milestone => {

        const stageId =
          getId(
            milestone.stage
          );


        if (
          !groups.has(
            stageId
          )
        ) {

          groups.set(
            stageId,
            []
          );

        }


        groups
          .get(stageId)
          .push(milestone);

      }
    );


    groups.forEach(
      (
        stageMilestones,
        stageId
      ) => {

        const stage =
          stages.find(
            item =>
              getId(item) ===
              stageId
          );


        const group =
          document.createElement(
            "optgroup"
          );


        group.label =
          stage
            ? `${stage.code || ""} — ${stage.name}`
            : "Stage";


        stageMilestones.sort(
          (a, b) =>
            (
              new Date(
                a.plannedDate
              ).getTime()
            ) -
            (
              new Date(
                b.plannedDate
              ).getTime()
            )
        );


        stageMilestones.forEach(
          milestone => {

            const option =
              document.createElement(
                "option"
              );


            option.value =
              getId(
                milestone
              );


            const code =
              milestone.milestoneCode
                ? `${milestone.milestoneCode} — `
                : "";


            option.textContent =
              `${code}${milestone.name}`;


            group.appendChild(
              option
            );

          }
        );


        editMilestoneSelect
          .appendChild(
            group
          );

      }
    );

  }


  /*
   * =========================================================
   * LOAD SINGLE MILESTONE
   * =========================================================
   */

  async function loadMilestone(
    milestoneId
  ) {

    if (!milestoneId) {
      return;
    }


    loadingMilestone =
      true;


    showMessage(
      "Loading milestone..."
    );


    try {

      const response =
        await apiRequest(
          `${API_BASE}/milestones/${milestoneId}`
        );


      const milestone =
        response?.milestone ||
        response?.data ||
        response;


      currentMilestoneId =
        getId(milestone);


      nameInput.value =
        milestone.name ||
        "";


      descriptionInput.value =
        milestone.description ||
        "";


      milestoneCodeInput.value =
        milestone.milestoneCode ||
        "";


      importanceSelect.value =
        milestone.importance ||
        "Medium";


      const stageId =
        getId(
          milestone.stage
        );


      renderStageOptions(
        stageId
      );


      stageSelect.value =
        stageId;


      await loadStageActivities(
        stageId,
        getId(
          milestone.activity
        )
      );


      plannedDateInput.value =
        dateInputValue(
          milestone.plannedDate
        );


      actualDateInput.value =
        dateInputValue(
          milestone.actualDate
        );


      statusSelect.value =
        milestone.status ||
        "Pending";


      notesInput.value =
        milestone.notes ||
        "";


      isActiveInput.checked =
        milestone.isActive !== false;


      clearMessage();

    } catch (error) {

      console.error(
        "Failed to load milestone:",
        error
      );


      showMessage(
        error.message ||
        "Failed to load milestone.",
        "error"
      );

    } finally {

      loadingMilestone =
        false;

    }

  }


  /*
   * =========================================================
   * RESET
   * =========================================================
   */

  function resetForm() {

    loadingMilestone =
      true;


    form.reset();


    currentMilestoneId =
      null;


    importanceSelect.value =
      "Medium";


    statusSelect.value =
      "Pending";


    isActiveInput.checked =
      true;


    stageActivities =
      [];


    renderStageOptions();


    activitySelect.innerHTML =
      "";


    const option =
      document.createElement(
        "option"
      );


    option.value =
      "";


    option.textContent =
      "No Activity";


    activitySelect.appendChild(
      option
    );


    loadingMilestone =
      false;


    clearMessage();

  }


  /*
   * =========================================================
   * MODE
   * =========================================================
   */

  async function setMode(
    mode
  ) {

    currentMode =
      mode;


    modeButtons.forEach(
      button => {

        button.classList.toggle(
          "active",
          button.dataset.mode ===
            mode
        );

      }
    );


    resetForm();


    if (
      mode === "create"
    ) {

      editMilestoneContainer.hidden =
        true;


      formTitle.textContent =
        "Create Milestone";


      formDescription.textContent =
        "Create a new milestone and associate it with a stage and activity.";


      submitButton.textContent =
        "Create Milestone";


      return;

    }


    editMilestoneContainer.hidden =
      false;


    formTitle.textContent =
      "Edit Milestone";


    formDescription.textContent =
      "Select an existing milestone and update its details.";


    submitButton.textContent =
      "Update Milestone";


    await loadMilestones();

  }


  /*
   * =========================================================
   * BUILD PAYLOAD
   * =========================================================
   */

  function buildPayload() {

    const payload = {

      stage:
        stageSelect.value,


      activity:
        activitySelect.value ||
        null,


      name:
        nameInput.value.trim(),


      description:
        descriptionInput.value.trim(),


      milestoneCode:
        milestoneCodeInput.value
          .trim()
          .toUpperCase(),


      plannedDate:
        plannedDateInput.value,


      actualDate:
        actualDateInput.value ||
        null,


      status:
        statusSelect.value,


      importance:
        importanceSelect.value,


      notes:
        notesInput.value.trim(),


      isActive:
        isActiveInput.checked

    };


    if (
      currentMode === "create"
    ) {

      payload.project =
        projectId;

    }


    return payload;

  }


  /*
   * =========================================================
   * EVENTS
   * =========================================================
   */

  stageSelect.addEventListener(
    "change",
    async () => {

      await loadStageActivities(
        stageSelect.value
      );

    }
  );


  milestoneCodeInput.addEventListener(
    "input",
    () => {

      milestoneCodeInput.value =
        milestoneCodeInput.value
          .toUpperCase();

    }
  );


  /*
   * Automatically change status
   * to Achieved when an actual
   * date is entered.
   *
   * The user can still manually
   * select another status.
   */

  actualDateInput.addEventListener(
    "change",
    () => {

      if (
        actualDateInput.value &&
        statusSelect.value ===
          "Pending"
      ) {

        statusSelect.value =
          "Achieved";

      }

    }
  );


  editMilestoneSelect.addEventListener(
    "change",
    async () => {

      const milestoneId =
        editMilestoneSelect.value;


      if (!milestoneId) {

        resetForm();

        return;

      }


      await loadMilestone(
        milestoneId
      );

    }
  );


  modeButtons.forEach(
    button => {

      button.addEventListener(
        "click",
        async () => {

          await setMode(
            button.dataset.mode
          );

        }
      );

    }
  );


  resetButton.addEventListener(
    "click",
    () => {

      resetForm();


      if (
        currentMode === "edit"
      ) {

        editMilestoneSelect.value =
          "";

      }

    }
  );


  /*
   * =========================================================
   * SUBMIT
   * =========================================================
   */

  form.addEventListener(
    "submit",
    async event => {

      event.preventDefault();


      clearMessage();


      const name =
        nameInput.value.trim();


      if (!name) {

        showMessage(
          "Milestone name is required.",
          "error"
        );

        return;

      }


      if (
        !stageSelect.value
      ) {

        showMessage(
          "Please select a stage or substage.",
          "error"
        );

        return;

      }


      if (
        !plannedDateInput.value
      ) {

        showMessage(
          "Planned date is required.",
          "error"
        );

        return;

      }


      if (
        currentMode === "edit" &&
        !currentMilestoneId
      ) {

        showMessage(
          "Please select a milestone to edit.",
          "error"
        );

        return;

      }


      /*
       * Actual date validation.
       */

      if (
        actualDateInput.value
      ) {

        const plannedDate =
          new Date(
            `${plannedDateInput.value}T00:00:00`
          );


        const actualDate =
          new Date(
            `${actualDateInput.value}T00:00:00`
          );


        /*
         * An actual achievement
         * date earlier than the
         * planned date is allowed
         * because it may represent
         * an early achievement.
         *
         * Therefore we do not reject
         * this condition.
         */

        if (
          Number.isNaN(
            plannedDate.getTime()
          ) ||
          Number.isNaN(
            actualDate.getTime()
          )
        ) {

          showMessage(
            "Please enter valid milestone dates.",
            "error"
          );

          return;

        }

      }


      /*
       * If an activity has been
       * selected, verify that it
       * belongs to the selected
       * stage.
       */

      if (
        activitySelect.value
      ) {

        const activityExists =
          stageActivities.some(
            activity =>
              getId(activity) ===
              activitySelect.value
          );


        if (
          !activityExists
        ) {

          showMessage(
            "The selected activity does not belong to the selected stage.",
            "error"
          );

          return;

        }

      }


      const payload =
        buildPayload();


      submitButton.disabled =
        true;


      submitButton.textContent =
        currentMode === "create"
          ? "Creating..."
          : "Updating...";


      try {

        let result;


        /*
         * CREATE
         */

        if (
          currentMode === "create"
        ) {

          result =
            await apiRequest(
              `${API_BASE}/milestones`,
              {
                method: "POST",

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          showMessage(
            "Milestone created successfully.",
            "success"
          );

        }


        /*
         * UPDATE
         */

        else {

          result =
            await apiRequest(
              `${API_BASE}/milestones/${currentMilestoneId}`,
              {
                method: "PUT",

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          showMessage(
            "Milestone updated successfully.",
            "success"
          );

        }


        /*
         * Notify dashboard.
         */

        document.dispatchEvent(
          new CustomEvent(
            "milestone:saved",
            {
              detail: {

                mode:
                  currentMode,

                milestone:
                  result?.milestone ||
                  result?.data ||
                  result

              }
            }
          )
        );


        /*
         * Refresh milestones.
         */

        await loadMilestones();


        /*
         * CREATE:
         * return to blank form.
         */

        if (
          currentMode === "create"
        ) {

          resetForm();

        }


        /*
         * EDIT:
         * retain selected milestone.
         */

        else {

          editMilestoneSelect.value =
            currentMilestoneId;

        }

      } catch (error) {

        console.error(
          "Milestone save failed:",
          error
        );


        showMessage(
          error.message ||
          "Failed to save milestone.",
          "error"
        );

      } finally {

        submitButton.disabled =
          false;


        submitButton.textContent =
          currentMode === "create"
            ? "Create Milestone"
            : "Update Milestone";

      }

    }
  );


  /*
   * =========================================================
   * INITIALISE
   * =========================================================
   */

  async function initialise() {

    try {

      await loadStages();


      await setMode(
        "create"
      );


    } catch (error) {

      console.error(
        "Milestone form initialisation failed:",
        error
      );


      showMessage(
        error.message ||
        "Failed to initialise milestone form.",
        "error"
      );

    }

  }


  initialise();

</script>


