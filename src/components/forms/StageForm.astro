---
const { projectId } = Astro.props;
---

<section class="stage-form-card">

  <!-- HEADER -->
  <div class="stage-form-header">
    <div class="stage-form-heading">
      <span class="stage-form-eyebrow">
        Stage Management
      </span>

      <h2 id="stageFormTitle">
        Create Stage
      </h2>

      <p id="stageFormDescription">
        Create a new top-level stage or substage.
      </p>
    </div>

    <div class="stage-mode-toggle">
      <button
        type="button"
        class="stage-mode-button active"
        data-mode="create"
      >
        Create
      </button>

      <button
        type="button"
        class="stage-mode-button"
        data-mode="edit"
      >
        Edit
      </button>
    </div>
  </div>


  <!-- EDIT STAGE SELECTOR -->
  <div
    id="editStageContainer"
    class="form-section edit-stage-section"
    hidden
  >
    <div class="section-heading">
      <h3>Select Stage</h3>

      <p>
        Select an existing stage or substage to edit its details.
      </p>
    </div>

    <div class="form-group">
      <label for="editStageSelect">
        Stage / Substage
      </label>

      <select id="editStageSelect">
        <option value="">
          Loading stages...
        </option>
      </select>
    </div>
  </div>


  <form id="stageForm">

    <!-- GENERAL INFORMATION -->
    <div class="form-section">

      <div class="section-heading">
        <h3>General Information</h3>

        <p>
          Basic information about the stage.
        </p>
      </div>

      <div class="form-grid">

        <div class="form-group form-group-full">
          <label for="name">
            Stage Name
            <span class="required">*</span>
          </label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter stage name"
            required
          />
        </div>


        <div class="form-group">
          <label for="code">
            Stage Code
            <span class="required">*</span>
          </label>

          <input
            type="text"
            id="code"
            name="code"
            placeholder="e.g. ENG-001"
            required
          />

          <small class="field-help">
            Stage codes are automatically converted to uppercase.
          </small>
        </div>


        <div class="form-group">
          <label for="sortOrder">
            Sort Order
          </label>

          <input
            type="number"
            id="sortOrder"
            name="sortOrder"
            min="0"
            value="0"
          />

          <small class="field-help">
            Determines the order of stages within the same parent.
          </small>
        </div>


        <div class="form-group form-group-full">
          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Describe the stage..."
          ></textarea>
        </div>

      </div>
    </div>


    <!-- HIERARCHY -->
    <div class="form-section">

      <div class="section-heading">
        <h3>Hierarchy</h3>

        <p>
          Define whether this is a top-level stage or a substage.
        </p>
      </div>

      <div class="form-grid">

        <div class="form-group">
          <label for="parentStage">
            Parent Stage
          </label>

          <select
            id="parentStage"
            name="parentStage"
          >
            <option value="">
              No Parent — Top-Level Stage
            </option>
          </select>

          <small class="field-help">
            Leave empty to create a top-level stage.
          </small>
        </div>


        <div class="form-group">
          <label for="level">
            Hierarchy Level
          </label>

          <div class="calculated-field">

            <input
              type="number"
              id="level"
              name="level"
              readonly
              value="0"
            />

            <span class="calculated-unit">
              level
            </span>

          </div>

          <small class="field-help">
            Automatically calculated from the selected parent stage.
          </small>
        </div>

      </div>
    </div>


    <!-- STATUS & PROGRESS -->
    <div class="form-section">

      <div class="section-heading">
        <h3>Status & Progress</h3>

        <p>
          Track the current state and completion of the stage.
        </p>
      </div>

      <div class="form-grid">

        <div class="form-group">
          <label for="status">
            Status
          </label>

          <select
            id="status"
            name="status"
          >
            <option value="Not Started">
              Not Started
            </option>

            <option value="Planned">
              Planned
            </option>

            <option value="In Progress">
              In Progress
            </option>

            <option value="On Hold">
              On Hold
            </option>

            <option value="Delayed">
              Delayed
            </option>

            <option value="Completed">
              Completed
            </option>

            <option value="Cancelled">
              Cancelled
            </option>
          </select>
        </div>


        <div class="form-group">
          <label for="progress">
            Progress (%)
          </label>

          <input
            type="number"
            id="progress"
            name="progress"
            min="0"
            max="100"
            value="0"
          />

          <small class="field-help">
            Enter the current completion percentage.
          </small>
        </div>

      </div>
    </div>


    <!-- SCHEDULE -->
    <div class="form-section">

      <div class="section-heading">
        <h3>Schedule</h3>

        <p>
          Define the planned and actual stage dates.
        </p>
      </div>

      <div class="form-grid">

        <div class="form-group">
          <label for="plannedStart">
            Planned Start
          </label>

          <input
            type="date"
            id="plannedStart"
            name="plannedStart"
          />
        </div>


        <div class="form-group">
          <label for="plannedFinish">
            Planned Finish
          </label>

          <input
            type="date"
            id="plannedFinish"
            name="plannedFinish"
          />
        </div>


        <div class="form-group">
          <label for="durationDays">
            Duration
          </label>

          <div class="calculated-field">

            <input
              type="number"
              id="durationDays"
              readonly
              placeholder="Calculated automatically"
            />

            <span class="calculated-unit">
              days
            </span>

          </div>

          <small class="field-help">
            Automatically calculated from planned start and finish.
          </small>
        </div>


        <div class="form-group">
          <label for="actualStart">
            Actual Start
          </label>

          <input
            type="date"
            id="actualStart"
            name="actualStart"
          />
        </div>


        <div class="form-group">
          <label for="actualFinish">
            Actual Finish
          </label>

          <input
            type="date"
            id="actualFinish"
            name="actualFinish"
          />
        </div>

      </div>
    </div>


    <!-- RESPONSIBILITY -->
    <div class="form-section">

      <div class="section-heading">
        <h3>Responsibility</h3>

        <p>
          Assign the organisation responsible for the stage.
        </p>
      </div>

      <div class="form-grid">

        <div class="form-group">
          <label for="responsibleOrganisation">
            Responsible Organisation
          </label>

          <select
            id="responsibleOrganisation"
            name="responsibleOrganisation"
          >
            <option value="">
              Loading organisations...
            </option>
          </select>
        </div>

      </div>
    </div>


    <!-- NOTES -->
    <div class="form-section">

      <div class="section-heading">
        <h3>Notes</h3>
      </div>

      <div class="form-group">

        <label for="notes">
          Notes
        </label>

        <textarea
          id="notes"
          name="notes"
          rows="4"
          placeholder="Additional notes..."
        ></textarea>

      </div>
    </div>


    <!-- ACTIONS -->
    <div class="form-actions">

      <button
        type="button"
        id="resetStageForm"
        class="secondary-button"
      >
        Reset
      </button>

      <button
        type="submit"
        id="submitStageButton"
        class="primary-button"
      >
        Create Stage
      </button>

    </div>

  </form>


  <div
    id="stageFormMessage"
    class="form-message"
    role="status"
    aria-live="polite"
  ></div>

</section>


<script define:vars={{ projectId }}>

  const API_BASE = "http://localhost:5000/api";

  let currentMode = "create";
  let currentStageId = null;

  let stages = [];
  let organisations = [];

  let loadingStage = false;


  /*
   * DOM REFERENCES
   */

  const form =
    document.getElementById("stageForm");

  const stageNameInput =
    document.getElementById("name");

  const codeInput =
    document.getElementById("code");

  const descriptionInput =
    document.getElementById("description");

  const sortOrderInput =
    document.getElementById("sortOrder");

  const parentStageSelect =
    document.getElementById("parentStage");

  const levelInput =
    document.getElementById("level");

  const statusSelect =
    document.getElementById("status");

  const progressInput =
    document.getElementById("progress");

  const plannedStartInput =
    document.getElementById("plannedStart");

  const plannedFinishInput =
    document.getElementById("plannedFinish");

  const durationInput =
    document.getElementById("durationDays");

  const actualStartInput =
    document.getElementById("actualStart");

  const actualFinishInput =
    document.getElementById("actualFinish");

  const organisationSelect =
    document.getElementById(
      "responsibleOrganisation"
    );

  const notesInput =
    document.getElementById("notes");

  const editStageContainer =
    document.getElementById(
      "editStageContainer"
    );

  const editStageSelect =
    document.getElementById(
      "editStageSelect"
    );

  const submitButton =
    document.getElementById(
      "submitStageButton"
    );

  const resetButton =
    document.getElementById(
      "resetStageForm"
    );

  const formMessage =
    document.getElementById(
      "stageFormMessage"
    );

  const formTitle =
    document.getElementById(
      "stageFormTitle"
    );

  const formDescription =
    document.getElementById(
      "stageFormDescription"
    );

  const modeButtons =
    document.querySelectorAll(
      ".stage-mode-button"
    );


  /*
   * HELPERS
   */

  function getId(value) {

    if (!value) {
      return "";
    }

    if (typeof value === "string") {
      return value;
    }

    if (typeof value === "object") {
      return (
        value._id ||
        value.id ||
        ""
      );
    }

    return String(value);
  }


  function dateInputValue(value) {

    if (!value) {
      return "";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "";
    }

    return date
      .toISOString()
      .slice(0, 10);
  }


  function showMessage(
    message,
    type = ""
  ) {

    formMessage.textContent =
      message;

    formMessage.className =
      `form-message ${type}`;
  }


  function clearMessage() {

    formMessage.textContent =
      "";

    formMessage.className =
      "form-message";
  }


  async function apiRequest(
    url,
    options = {}
  ) {

    const response =
      await fetch(
        url,
        {
          headers: {
            "Content-Type":
              "application/json",

            ...(options.headers || {})
          },

          ...options
        }
      );


    let data = null;


    try {

      data =
        await response.json();

    } catch {

      data = null;

    }


    if (!response.ok) {

      throw new Error(
        data?.message ||
        data?.error ||
        "Request failed."
      );

    }


    return data;

  }


  /*
   * DATE / DURATION
   */

  function calculateDuration() {

    const start =
      plannedStartInput.value;

    const finish =
      plannedFinishInput.value;


    if (
      !start ||
      !finish
    ) {

      durationInput.value =
        "";

      return null;

    }


    const startDate =
      new Date(
        `${start}T00:00:00`
      );

    const finishDate =
      new Date(
        `${finish}T00:00:00`
      );


    if (
      Number.isNaN(
        startDate.getTime()
      ) ||
      Number.isNaN(
        finishDate.getTime()
      )
    ) {

      durationInput.value =
        "";

      return null;

    }


    const difference =
      finishDate.getTime() -
      startDate.getTime();


    const days =
      Math.floor(
        difference /
        (1000 * 60 * 60 * 24)
      ) + 1;


    if (days <= 0) {

      durationInput.value =
        "";

      return null;

    }


    durationInput.value =
      days;


    return days;

  }


  /*
   * HIERARCHY LEVEL
   */

  function calculateLevel(
    parentId =
      parentStageSelect.value
  ) {

    if (!parentId) {

      levelInput.value =
        "0";

      return 0;

    }


    const parent =
      stages.find(
        stage =>
          getId(stage) ===
          parentId
      );


    if (!parent) {

      levelInput.value =
        "0";

      return 0;

    }


    const parentLevel =
      Number(
        parent.level
      ) || 0;


    const level =
      parentLevel + 1;


    levelInput.value =
      level;


    return level;

  }


  /*
   * STAGE TREE
   */

  function buildStageChildrenMap() {

    const children =
      new Map();


    stages.forEach(
      stage => {

        const parentId =
          getId(
            stage.parentStage
          );


        if (
          !children.has(
            parentId
          )
        ) {

          children.set(
            parentId,
            []
          );

        }


        children
          .get(parentId)
          .push(stage);

      }
    );


    children.forEach(
      stageList => {

        stageList.sort(
          (a, b) =>
            (
              Number(
                a.sortOrder
              ) || 0
            ) -
            (
              Number(
                b.sortOrder
              ) || 0
            )
        );

      }
    );


    return children;

  }


  /*
   * FIND DESCENDANTS
   */

  function getDescendantIds(
    stageId
  ) {

    const descendants =
      new Set();


    const children =
      buildStageChildrenMap();


    function collect(
      parentId
    ) {

      const childStages =
        children.get(
          parentId
        ) || [];


      childStages.forEach(
        child => {

          const childId =
            getId(child);


          if (!childId) {
            return;
          }


          if (
            descendants.has(
              childId
            )
          ) {
            return;
          }


          descendants.add(
            childId
          );


          collect(
            childId
          );

        }
      );

    }


    collect(stageId);


    return descendants;

  }


  /*
   * LOAD ALL STAGES
   */

  async function loadStages() {

    try {

      const response =
        await apiRequest(
          `${API_BASE}/stages/project/${projectId}`
        );


      const topLevelStages =
        Array.isArray(response)
          ? response
          : (
              response?.stages ||
              response?.data ||
              []
            );


      const stageMap =
        new Map();


      topLevelStages.forEach(
        stage => {

          const id =
            getId(stage);


          if (id) {

            stageMap.set(
              id,
              stage
            );

          }

        }
      );


      async function loadChildren(
        parentStage
      ) {

        const parentId =
          getId(parentStage);


        if (!parentId) {
          return;
        }


        try {

          const response =
            await apiRequest(
              `${API_BASE}/stages/${parentId}/substages`
            );


          const children =
            Array.isArray(response)
              ? response
              : (
                  response?.substages ||
                  response?.stages ||
                  response?.data ||
                  []
                );


          for (
            const child of children
          ) {

            const childId =
              getId(child);


            if (!childId) {
              continue;
            }


            if (
              !stageMap.has(
                childId
              )
            ) {

              stageMap.set(
                childId,
                child
              );

            }


            await loadChildren(
              child
            );

          }

        } catch (error) {

          console.error(
            `Failed to load substages for ${parentId}`,
            error
          );

        }

      }


      await Promise.all(
        topLevelStages.map(
          stage =>
            loadChildren(stage)
        )
      );


      stages =
        Array.from(
          stageMap.values()
        );


      renderParentStageOptions();


      renderEditStageOptions();

    } catch (error) {

      console.error(
        "Failed to load stages:",
        error
      );

      throw error;

    }

  }


  /*
   * RENDER PARENT STAGE OPTIONS
   */

  function renderParentStageOptions(
    selectedId = ""
  ) {

    parentStageSelect.innerHTML =
      "";


    const defaultOption =
      document.createElement(
        "option"
      );


    defaultOption.value =
      "";


    defaultOption.textContent =
      "No Parent — Top-Level Stage";


    parentStageSelect.appendChild(
      defaultOption
    );


    const children =
      buildStageChildrenMap();


    let excludedIds =
      new Set();


    if (currentStageId) {

      excludedIds =
        getDescendantIds(
          currentStageId
        );


      excludedIds.add(
        currentStageId
      );

    }


    function addStages(
      parentId = "",
      depth = 0
    ) {

      const childStages =
        children.get(
          parentId
        ) || [];


      childStages.forEach(
        stage => {

          const stageId =
            getId(stage);


          if (
            excludedIds.has(
              stageId
            )
          ) {

            addStages(
              stageId,
              depth + 1
            );

            return;

          }


          const option =
            document.createElement(
              "option"
            );


          option.value =
            stageId;


          const prefix =
            depth > 0
              ? `${"— ".repeat(depth)}`
              : "";


          const code =
            stage.code
              ? `${stage.code} — `
              : "";


          option.textContent =
            `${prefix}${code}${stage.name}`;


          option.selected =
            stageId === selectedId;


          parentStageSelect.appendChild(
            option
          );


          addStages(
            stageId,
            depth + 1
          );

        }
      );

    }


    addStages();


    calculateLevel(
      selectedId
    );

  }


  /*
   * RENDER EDIT SELECT
   */

  function renderEditStageOptions() {

    editStageSelect.innerHTML =
      "";


    const defaultOption =
      document.createElement(
        "option"
      );


    defaultOption.value =
      "";


    defaultOption.textContent =
      "Select a stage...";


    editStageSelect.appendChild(
      defaultOption
    );


    const children =
      buildStageChildrenMap();


    function addStages(
      parentId = "",
      depth = 0
    ) {

      const childStages =
        children.get(
          parentId
        ) || [];


      childStages.forEach(
        stage => {

          const option =
            document.createElement(
              "option"
            );


          const stageId =
            getId(stage);


          option.value =
            stageId;


          const prefix =
            depth > 0
              ? `${"— ".repeat(depth)}`
              : "";


          const code =
            stage.code
              ? `${stage.code} — `
              : "";


          option.textContent =
            `${prefix}${code}${stage.name}`;


          editStageSelect.appendChild(
            option
          );


          addStages(
            stageId,
            depth + 1
          );

        }
      );

    }


    addStages();

  }


  /*
   * LOAD ORGANISATIONS
   */

  async function loadOrganisations() {

    organisationSelect.innerHTML =
      `
        <option value="">
          Loading organisations...
        </option>
      `;


    const response =
      await apiRequest(
        `${API_BASE}/organisations`
      );


    organisations =
      Array.isArray(response)
        ? response
        : (
            response?.organisations ||
            response?.data ||
            []
          );


    organisations =
      organisations.filter(
        organisation =>
          organisation.active !== false
      );


    organisationSelect.innerHTML =
      "";


    const defaultOption =
      document.createElement(
        "option"
      );


    defaultOption.value =
      "";


    defaultOption.textContent =
      "Select organisation...";


    organisationSelect.appendChild(
      defaultOption
    );


    organisations.forEach(
      organisation => {

        const option =
          document.createElement(
            "option"
          );


        option.value =
          getId(
            organisation
          );


        const code =
          organisation.code
            ? `${organisation.code} — `
            : "";


        option.textContent =
          `${code}${organisation.name}`;


        organisationSelect.appendChild(
          option
        );

      }
    );

  }


  /*
   * LOAD SINGLE STAGE
   */

  async function loadStage(
    stageId
  ) {

    if (!stageId) {
      return;
    }


    loadingStage = true;


    showMessage(
      "Loading stage..."
    );


    try {

      const response =
        await apiRequest(
          `${API_BASE}/stages/${stageId}`
        );


      const stage =
        response?.stage ||
        response?.data ||
        response;


      currentStageId =
        getId(stage);


      stageNameInput.value =
        stage.name || "";


      codeInput.value =
        stage.code || "";


      descriptionInput.value =
        stage.description || "";


      sortOrderInput.value =
        stage.sortOrder ?? 0;


      const parentId =
        getId(
          stage.parentStage
        );


      renderParentStageOptions(
        parentId
      );


      parentStageSelect.value =
        parentId;


      calculateLevel(
        parentId
      );


      statusSelect.value =
        stage.status ||
        "Not Started";


      progressInput.value =
        stage.progress ??
        0;


      plannedStartInput.value =
        dateInputValue(
          stage.plannedStart
        );


      plannedFinishInput.value =
        dateInputValue(
          stage.plannedFinish
        );


      actualStartInput.value =
        dateInputValue(
          stage.actualStart
        );


      actualFinishInput.value =
        dateInputValue(
          stage.actualFinish
        );


      calculateDuration();


      organisationSelect.value =
        getId(
          stage.responsibleOrganisation
        );


      notesInput.value =
        stage.notes || "";


      clearMessage();

    } catch (error) {

      console.error(
        "Failed to load stage:",
        error
      );


      showMessage(
        error.message ||
        "Failed to load stage.",
        "error"
      );

    } finally {

      loadingStage = false;

    }

  }


  /*
   * RESET FORM
   */

  function resetForm() {

    loadingStage = true;


    form.reset();


    currentStageId =
      null;


    statusSelect.value =
      "Not Started";


    progressInput.value =
      0;


    sortOrderInput.value =
      0;


    levelInput.value =
      0;


    durationInput.value =
      "";


    parentStageSelect.value =
      "";


    renderParentStageOptions();


    loadingStage = false;


    clearMessage();

  }


  /*
   * MODE
   */

  async function setMode(
    mode
  ) {

    currentMode =
      mode;


    modeButtons.forEach(
      button => {

        button.classList.toggle(
          "active",
          button.dataset.mode ===
            mode
        );

      }
    );


    resetForm();


    if (
      mode === "create"
    ) {

      editStageContainer.hidden =
        true;


      formTitle.textContent =
        "Create Stage";


      formDescription.textContent =
        "Create a new top-level stage or substage.";


      submitButton.textContent =
        "Create Stage";


      return;

    }


    editStageContainer.hidden =
      false;


    formTitle.textContent =
      "Edit Stage";


    formDescription.textContent =
      "Select an existing stage and update its details.";


    submitButton.textContent =
      "Update Stage";


    renderEditStageOptions();

  }


  /*
   * BUILD PAYLOAD
   */

  function buildPayload() {

    const payload = {

      name:
        stageNameInput.value.trim(),


      code:
        codeInput.value
          .trim()
          .toUpperCase(),


      description:
        descriptionInput.value.trim(),


      parentStage:
        parentStageSelect.value ||
        null,


      level:
        calculateLevel(),


      sortOrder:
        Number(
          sortOrderInput.value
        ) || 0,


      status:
        statusSelect.value,


      progress:
        Number(
          progressInput.value
        ) || 0,


      plannedStart:
        plannedStartInput.value ||
        null,


      plannedFinish:
        plannedFinishInput.value ||
        null,


      actualStart:
        actualStartInput.value ||
        null,


      actualFinish:
        actualFinishInput.value ||
        null,


      responsibleOrganisation:
        organisationSelect.value ||
        null,


      notes:
        notesInput.value.trim()

    };


    if (
      currentMode === "create"
    ) {

      payload.project =
        projectId;

    }


    return payload;

  }


  /*
   * EVENTS
   */

  parentStageSelect.addEventListener(
    "change",
    () => {

      calculateLevel(
        parentStageSelect.value
      );

    }
  );


  plannedStartInput.addEventListener(
    "change",
    () => {

      calculateDuration();

    }
  );


  plannedFinishInput.addEventListener(
    "change",
    () => {

      calculateDuration();

    }
  );


  codeInput.addEventListener(
    "input",
    () => {

      codeInput.value =
        codeInput.value.toUpperCase();

    }
  );


  editStageSelect.addEventListener(
    "change",
    async () => {

      const stageId =
        editStageSelect.value;


      if (!stageId) {

        resetForm();

        return;

      }


      await loadStage(
        stageId
      );

    }
  );


  modeButtons.forEach(
    button => {

      button.addEventListener(
        "click",
        async () => {

          await setMode(
            button.dataset.mode
          );

        }
      );

    }
  );


  resetButton.addEventListener(
    "click",
    () => {

      resetForm();


      if (
        currentMode === "edit"
      ) {

        editStageSelect.value =
          "";

      }

    }
  );


  /*
   * SUBMIT
   */

  form.addEventListener(
    "submit",
    async event => {

      event.preventDefault();


      clearMessage();


      const name =
        stageNameInput.value.trim();


      const code =
        codeInput.value.trim();


      if (!name) {

        showMessage(
          "Stage name is required.",
          "error"
        );

        return;

      }


      if (!code) {

        showMessage(
          "Stage code is required.",
          "error"
        );

        return;

      }


      if (
        currentMode === "edit" &&
        !currentStageId
      ) {

        showMessage(
          "Please select a stage to edit.",
          "error"
        );

        return;

      }


      if (
        currentStageId &&
        parentStageSelect.value ===
          currentStageId
      ) {

        showMessage(
          "A stage cannot be its own parent.",
          "error"
        );

        return;

      }


      if (
        currentStageId &&
        parentStageSelect.value
      ) {

        const descendants =
          getDescendantIds(
            currentStageId
          );


        if (
          descendants.has(
            parentStageSelect.value
          )
        ) {

          showMessage(
            "A stage cannot have one of its descendants as its parent.",
            "error"
          );

          return;

        }

      }


      if (
        plannedStartInput.value &&
        plannedFinishInput.value
      ) {

        const start =
          new Date(
            `${plannedStartInput.value}T00:00:00`
          );


        const finish =
          new Date(
            `${plannedFinishInput.value}T00:00:00`
          );


        if (
          finish < start
        ) {

          showMessage(
            "Planned Finish cannot be before Planned Start.",
            "error"
          );

          return;

        }

      }


      if (
        actualStartInput.value &&
        actualFinishInput.value
      ) {

        const actualStart =
          new Date(
            `${actualStartInput.value}T00:00:00`
          );


        const actualFinish =
          new Date(
            `${actualFinishInput.value}T00:00:00`
          );


        if (
          actualFinish < actualStart
        ) {

          showMessage(
            "Actual Finish cannot be before Actual Start.",
            "error"
          );

          return;

        }

      }


      const progress =
        Number(
          progressInput.value
        );


      if (
        progress < 0 ||
        progress > 100
      ) {

        showMessage(
          "Progress must be between 0 and 100.",
          "error"
        );

        return;

      }


      calculateDuration();


      const payload =
        buildPayload();


      submitButton.disabled =
        true;


      submitButton.textContent =
        currentMode === "create"
          ? "Creating..."
          : "Updating...";


      try {

        let result;


        if (
          currentMode === "create"
        ) {

          result =
            await apiRequest(
              `${API_BASE}/stages`,
              {
                method: "POST",

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          showMessage(
            "Stage created successfully.",
            "success"
          );

        } else {

          result =
            await apiRequest(
              `${API_BASE}/stages/${currentStageId}`,
              {
                method: "PUT",

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          showMessage(
            "Stage updated successfully.",
            "success"
          );

        }


        document.dispatchEvent(
          new CustomEvent(
            "stage:saved",
            {
              detail: {

                mode:
                  currentMode,

                stage:
                  result?.stage ||
                  result?.data ||
                  result

              }
            }
          )
        );


        await loadStages();


        if (
          currentMode === "create"
        ) {

          resetForm();

        } else {

          editStageSelect.value =
            currentStageId;

        }

      } catch (error) {

        console.error(
          "Stage save failed:",
          error
        );


        showMessage(
          error.message ||
          "Failed to save stage.",
          "error"
        );

      } finally {

        submitButton.disabled =
          false;


        submitButton.textContent =
          currentMode === "create"
            ? "Create Stage"
            : "Update Stage";

      }

    }
  );


  /*
   * INITIALISE
   */

  async function initialise() {

    try {

      await Promise.all([
        loadStages(),
        loadOrganisations()
      ]);


      await setMode(
        "create"
      );


    } catch (error) {

      console.error(
        "Stage form initialisation failed:",
        error
      );


      showMessage(
        error.message ||
        "Failed to initialise stage form.",
        "error"
      );

    }

  }


  initialise();

</script>


