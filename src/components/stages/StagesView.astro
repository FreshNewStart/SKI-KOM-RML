---
interface Props {
  projectId: string;
  apiBase: string;
}

const {
  projectId,
  apiBase,
} = Astro.props;
---

<div
  class="stage-tree"
  id="stageTree"
  data-project-id={projectId}
  data-api-base={apiBase}
>
  <section class="item-detail" aria-live="polite" aria-atomic="true">
    <p class="item-detail-label">Focused item</p>
    <h2 id="focusedItemName">Project Structure</h2>
    <p id="focusedItemNote">
      Select a stage, substage, or activity to view its details.
    </p>
  </section>

  <section
    class="tree-section"
    id="treeSection"
    aria-label="Project stages and activities"
  >
    <div class="tree-content" id="treeContent">
      <div class="tree-loading">
        <span class="spinner"></span>
        <span>Loading project structure...</span>
      </div>
    </div>
  </section>
</div>

<script>
  import { getAuthHeaders as getSharedAuthHeaders } from "../../lib/auth.js";
  import { subscribeToDatabaseChanges } from "../../lib/realtime.js";

  /**
   * @typedef {Object} TreeItem
   * @property {string|number} [_id]
   * @property {string|number} [id]
   * @property {string} [name]
   * @property {string} [code]
   * @property {string} [activityCode]
   * @property {string} [status]
   * @property {number|string} [progress]
   * @property {TreeItem[]} [substages]
   * @property {TreeItem[]} [activities]
   */
  /**
   * @typedef {Object} FocusedItem
   * @property {"stage"|"substage"|"activity"} type
   * @property {string|null} id
   * @property {string} name
   */
  /**
   * @typedef {Object} SearchResult
   * @property {"stage"|"substage"|"activity"} type
   * @property {string} id
   * @property {string} name
   * @property {string} code
   * @property {string} status
   * @property {number} progress
   * @property {string} parentPath
   * @property {string} key
   * @property {TreeItem} item
   */

  const treeContainer = document.getElementById("stageTree");
  if (!treeContainer) {
    throw new Error("The project stage tree container was not found.");
  }

  const { projectId, apiBase } = treeContainer.dataset;

  /** @type {TreeItem[]} */
  let stageTree = [];
  let treeLoaded = false;
  let treeLoading = false;
  let treeReloadQueued = false;
  let treeLoadError = null;
  let searchQuery = "";
  const expandedSearchResults = new Set();
  /** @type {FocusedItem|null} */
  let focusedItem = null;
  const treeSection = treeContainer.querySelector(".tree-section");
  const treeContent = treeContainer.querySelector(".tree-content");
  const focusedItemName = treeContainer.querySelector("#focusedItemName");
  const focusedItemNote = treeContainer.querySelector("#focusedItemNote");
  if (
    !(treeSection instanceof HTMLElement) ||
    !(treeContent instanceof HTMLElement) ||
    !(focusedItemName instanceof HTMLElement) ||
    !(focusedItemNote instanceof HTMLElement)
  ) {
    throw new Error("The project stage tree is missing a required display section.");
  }

  /*
   * ------------------------------------------------------------
   * API HELPERS
   * ------------------------------------------------------------
   */

  async function fetchJSON(url) {
    console.log("Fetching:", url);

    const response = await fetch(url, {
      method: "GET",
      headers: getSharedAuthHeaders(),
      cache: "no-store",
    });

    const contentType =
      response.headers.get("content-type") || "";

    let result;

    if (contentType.includes("application/json")) {
      result = await response.json();
    } else {
      const text = await response.text();

      throw new Error(
        `Expected JSON but received: ${text.substring(0, 200)}`
      );
    }

    if (!response.ok) {
      throw new Error(
        result?.message ||
        `Request failed with status ${response.status}`
      );
    }

    return result;
  }


  /**
   * @param {unknown} value
   * @returns {value is TreeItem}
   */
  function isTreeItem(value) {
    return typeof value === "object" && value !== null;
  }


  /**
   * @param {unknown} response
   * @returns {TreeItem[]}
   */
  function extractData(response) {
    let data = [];

    if (Array.isArray(response)) {
      data = response;
    } else if (
      typeof response === "object" &&
      response !== null &&
      "data" in response &&
      Array.isArray(response.data)
    ) {
      data = response.data;
    }

    return data.filter(isTreeItem);
  }


  /*
   * ------------------------------------------------------------
   * LOAD STAGES
   * ------------------------------------------------------------
   */

  /** @returns {Promise<TreeItem[]>} */
  async function getTopLevelStages() {
    const response = await fetchJSON(
      `${apiBase}/stages/project/${projectId}`
    );

    return extractData(response);
  }


  /**
   * @param {string} stageId
   * @returns {Promise<TreeItem[]>}
   */
  async function getSubstages(stageId) {
    const response = await fetchJSON(
      `${apiBase}/stages/${stageId}/substages`
    );

    return extractData(response);
  }


  /**
   * @param {string} stageId
   * @returns {Promise<TreeItem[]>}
   */
  async function getActivities(stageId) {
    const response = await fetchJSON(
      `${apiBase}/activities/stage/${stageId}`
    );

    return extractData(response);
  }


  /*
   * ------------------------------------------------------------
   * BUILD TREE
   * ------------------------------------------------------------
   */

  /**
   * @param {TreeItem} stage
   * @returns {Promise<TreeItem>}
   */
  async function buildStage(stage) {
    const stageId = stage._id || stage.id;
    if (!stageId) {
      return {
        ...stage,
        activities: [],
        substages: [],
      };
    }

    /*
     * Load substages and activities at the same time.
     */
    const [substages, activities] = await Promise.all([
      getSubstages(stageId),
      getActivities(stageId),
    ]);

    /*
     * Recursively build every child stage.
     */
    const children = await Promise.all(
      substages.map((substage) =>
        buildStage(substage)
      )
    );

    return {
      ...stage,
      activities,
      substages: children,
    };
  }


  async function loadTree() {
    if (treeLoading) {
      treeReloadQueued = true;
      return;
    }

    treeLoading = true;
    const viewState = captureTreeState();
    treeLoadError = null;

    try {
      if (!treeLoaded) showLoading();

      const topLevelStages =
        await getTopLevelStages();

      stageTree = await Promise.all(
        topLevelStages.map((stage) =>
          buildStage(stage)
        )
      );

      treeLoadError = null;
      treeLoaded = true;
      renderTree(viewState);

    } catch (error) {
      console.error(
        "Failed to load stage tree:",
        error
      );

      treeLoadError = error instanceof Error ? error.message : String(error);
      if (!treeLoaded) showError(treeLoadError);
    } finally {
      treeLoading = false;
      if (treeReloadQueued) {
        treeReloadQueued = false;
        void loadTree();
      }
    }
  }

  const unsubscribeRealtime = subscribeToDatabaseChanges(
    (events) => {
      if (
        events.some((event) =>
          event.requiresRefetch ||
          event.type?.startsWith("connection.")
        )
      ) {
        void loadTree();
      }
    },
    {
      projectId,
      classifications: ["stage", "activity", "progress"],
    }
  );
  document.addEventListener(
    "astro:before-swap",
    unsubscribeRealtime,
    { once: true }
  );


  /*
   * ------------------------------------------------------------
   * DISPLAY HELPERS
   * ------------------------------------------------------------
   */

  /**
   * @param {TreeItem|null|undefined} item
   */
  function getId(item) {
    return item ? String(item._id ?? item.id ?? "") : "";
  }


  /**
   * @param {unknown} value
   */
  function escapeHTML(value) {
    if (value === null || value === undefined) {
      return "";
    }

    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }


  /**
   * @param {string} status
   */
  function getStatusClass(status) {
    if (!status) return "status-default";

    return (
      "status-" +
      String(status)
        .toLowerCase()
        .replaceAll(" ", "-")
        .replace(/[^a-z0-9-]/g, "")
    );
  }


  /**
   * @param {unknown} value
   */
  function getProgress(value) {
    const progress = Number(value);

    if (Number.isNaN(progress)) {
      return 0;
    }

    return Math.max(
      0,
      Math.min(100, progress)
    );
  }


  /*
   * ------------------------------------------------------------
   * RENDER ACTIVITY
   * ------------------------------------------------------------
   */

  /**
   * @param {TreeItem} activity
   */
  function renderActivity(activity) {
    const activityId = getId(activity);

    const name =
      activity.name ||
      "Unnamed Activity";

    const code =
      activity.activityCode || "";

    const progress =
      getProgress(activity.progress);

    const status =
      activity.status ||
      "Not Started";

    return `
      <div
        class="tree-item activity-item"
        data-type="activity"
        data-id="${escapeHTML(activityId)}"
        role="treeitem"
        tabindex="0"
        aria-selected="false"
      >

        <div class="tree-indent activity-indent">
          <span class="tree-branch">└</span>

          <span class="activity-icon">
            task_alt
          </span>

          <div class="item-content">

            <div class="item-main">

              <span class="item-name">
                ${escapeHTML(name)}
              </span>

              ${
                code
                  ? `
                    <span class="item-code">
                      ${escapeHTML(code)}
                    </span>
                  `
                  : ""
              }

            </div>

            <div class="item-meta">

              <span
                class="status-badge ${getStatusClass(status)}"
              >
                ${escapeHTML(status)}
              </span>

              <span class="progress-text">
                ${progress}%
              </span>

            </div>

          </div>

          <div class="item-progress">

            <div class="progress-track">
              <div
                class="progress-fill"
                style="width:${progress}%"
              ></div>
            </div>

          </div>

        </div>

      </div>
    `;
  }


  /*
   * ------------------------------------------------------------
   * RENDER STAGE
   * ------------------------------------------------------------
   */

  /**
   * @param {TreeItem} stage
   * @param {number} [level]
   * @param {boolean} [isSubstage]
   */
  function renderStage(stage, level = 0, isSubstage = false) {
    const stageId = getId(stage);

    const name =
      stage.name ||
      "Unnamed Stage";

    const code =
      stage.code ||
      "";

    const status =
      stage.status ||
      "Not Started";

    const progress =
      getProgress(stage.progress);

    const substages =
      stage.substages || [];

    const activities =
      stage.activities || [];

    const totalChildren =
      substages.length +
      activities.length;

    const hasChildren =
      totalChildren > 0;

    return `
      <div
        class="stage-node"
        data-stage-id="${escapeHTML(stageId)}"
        data-level="${level}"
        data-type="${isSubstage ? "substage" : "stage"}"
      >

        <div
          class="stage-row"
          data-id="${escapeHTML(stageId)}"
          role="treeitem"
          tabindex="0"
          aria-selected="false"
        >

          ${
            hasChildren
              ? `
                <button
                  type="button"
                  class="expand-button"
                  aria-expanded="false"
                  aria-label="Expand ${escapeHTML(name)}"
                  title="Expand"
                >
                  <span class="material-symbols-rounded">
                    chevron_right
                  </span>
                </button>
              `
              : `
                <span class="expand-placeholder"></span>
              `
          }

          <span class="stage-icon">
            ${
              level === 0
                ? "account_tree"
                : "subdirectory_arrow_right"
            }
          </span>

          <div class="stage-main">

            <div class="stage-title-row">

              <span class="stage-name">
                ${escapeHTML(name)}
              </span>

              ${
                code
                  ? `
                    <span class="stage-code">
                      ${escapeHTML(code)}
                    </span>
                  `
                  : ""
              }

            </div>

            <div class="stage-meta">

              <span
                class="status-badge ${getStatusClass(status)}"
              >
                ${escapeHTML(status)}
              </span>

              <span class="stage-progress">
                ${progress}%
              </span>

            </div>

          </div>

          <div class="stage-progress-container">

            <div class="progress-track">
              <div
                class="progress-fill"
                style="width:${progress}%"
              ></div>
            </div>

          </div>

        </div>


        ${
          hasChildren
            ? `
              <div class="stage-children" role="group">

                ${
                  substages.length
                    ? substages
                        .map((substage) =>
                          renderStage(
                            substage,
                            level + 1,
                            true
                          )
                        )
                        .join("")
                    : ""
                }

                ${
                  activities.length
                    ? `
                      <div class="activities-container" role="group">

                        ${activities
                          .map(
                            (activity) =>
                              renderActivity(
                                activity
                              )
                          )
                          .join("")}

                      </div>
                    `
                    : ""
                }

              </div>
            `
            : ""
        }

      </div>
    `;
  }


  /*
   * ------------------------------------------------------------
   * RENDER COMPLETE TREE
   * ------------------------------------------------------------
   */

  function captureTreeState() {
    const expanded = new Set();

    treeContainer.querySelectorAll(".stage-node").forEach((node) => {
      const stageId = node.getAttribute("data-stage-id");
      const children = node.querySelector(":scope > .stage-children");
      const expandButton = node.querySelector(":scope > .stage-row .expand-button");

      if (
        stageId &&
        (children?.classList.contains("is-open") ||
          expandButton?.getAttribute("aria-expanded") === "true")
      ) {
        expanded.add(stageId);
      }
    });

    return { expanded };
  }


  function renderSearchBar() {
    return `
      <div class="tree-search">
        <span class="material-symbols-rounded tree-search-icon" aria-hidden="true">
          search
        </span>
        <label class="visually-hidden" for="stageSearch">
          Search stages, substages, and activities
        </label>
        <input
          id="stageSearch"
          class="tree-search-input"
          type="search"
          value="${escapeHTML(searchQuery)}"
          placeholder="Search stages, substages, and activities..."
          autocomplete="off"
          aria-controls="stageSearchResults"
        />
        <button
          type="button"
          id="clearStageSearch"
          class="tree-search-clear"
          aria-label="Clear search"
          ${searchQuery ? "" : "hidden"}
        >
          <span class="material-symbols-rounded" aria-hidden="true">close</span>
        </button>
      </div>
    `;
  }

  /**
   * @returns {SearchResult[]}
   */
  function getSearchResults() {
    const query = searchQuery.trim().toLocaleLowerCase();
    if (!query) return [];

    const terms = query.split(/\s+/);
    /** @type {SearchResult[]} */
    const results = [];
    const seen = new Set();
    const seenWithoutId = new WeakSet();

    /**
     * @param {TreeItem} item
     * @param {"stage"|"substage"|"activity"} type
     * @param {string} parentPath
     * @param {string} code
     */
    function addResult(item, type, parentPath, code) {
      const id = getId(item);
      const uniqueKey = id ? `${type}:${id}` : null;
      if (uniqueKey && seen.has(uniqueKey)) return;
      if (!uniqueKey && seenWithoutId.has(item)) return;

      const name = String(
        item.name ||
          (type === "activity" ? "Unnamed Activity" : "Unnamed Stage")
      );
      const searchableText = [name, code]
        .filter(Boolean)
        .join(" ")
        .toLocaleLowerCase();

      if (!terms.every((term) => searchableText.includes(term))) return;
      if (uniqueKey) seen.add(uniqueKey);
      else seenWithoutId.add(item);

      results.push(createSearchResult(item, type, parentPath, code));
    }

    /**
     * @param {TreeItem} stage
     * @param {string[]} ancestors
     * @param {boolean} isSubstage
     */
    function visitStage(stage, ancestors, isSubstage) {
      const type = isSubstage ? "substage" : "stage";
      const name = String(stage.name || "Unnamed Stage");
      const stagePath = [...ancestors, name];
      addResult(stage, type, ancestors.join(" › "), String(stage.code || ""));

      for (const activity of stage.activities || []) {
        addResult(
          activity,
          "activity",
          stagePath.join(" › "),
          String(activity.activityCode || activity.code || "")
        );
      }

      for (const substage of stage.substages || []) {
        visitStage(substage, stagePath, true);
      }
    }

    for (const stage of stageTree) {
      visitStage(stage, [], false);
    }

    return results;
  }

  /**
   * @param {TreeItem} item
   * @param {"stage"|"substage"|"activity"} type
   * @param {string} parentPath
   * @param {string} code
   * @returns {SearchResult}
   */
  function createSearchResult(item, type, parentPath, code) {
    const id = getId(item);
    const name = String(
      item.name ||
        (type === "activity" ? "Unnamed Activity" : "Unnamed Stage")
    );

    return {
      type,
      id,
      name,
      code,
      status: String(item.status || "Not Started"),
      progress: getProgress(item.progress),
      parentPath,
      key: id
        ? `${type}:${id}`
        : `${type}:${parentPath}:${name}`,
      item,
    };
  }


  /**
   * @param {SearchResult} result
   * @returns {SearchResult[]}
   */
  function getSearchResultChildren(result) {
    if (result.type === "activity") return [];

    const childPath = [result.parentPath, result.name]
      .filter(Boolean)
      .join(" › ");
    const substages = (result.item.substages || []).map((substage) =>
      createSearchResult(
        substage,
        "substage",
        childPath,
        String(substage.code || "")
      )
    );
    const activities = (result.item.activities || []).map((activity) =>
      createSearchResult(
        activity,
        "activity",
        childPath,
        String(activity.activityCode || activity.code || "")
      )
    );

    return [...substages, ...activities];
  }


  /**
   * @param {SearchResult} result
   * @returns {string}
   */
  function renderSearchResult(result) {
    const children = getSearchResultChildren(result);
    const isExpanded = expandedSearchResults.has(result.key);
    const isFocused =
      focusedItem?.type === result.type && focusedItem.id === result.id;

    return `
      <div class="search-result-item">
        <div class="search-result-row">
          <button
            type="button"
            class="search-result${isFocused ? " is-focused" : ""}"
            data-type="${result.type}"
            data-id="${escapeHTML(result.id)}"
            aria-current="${isFocused ? "true" : "false"}"
          >
            <span class="search-result-main">
              <span class="search-result-name">${escapeHTML(result.name)}</span>
              <span class="search-result-type">${result.type === "stage" ? "Stage" : result.type === "substage" ? "Substage" : "Activity"}</span>
              ${
                result.parentPath
                  ? `<span class="search-result-path">${escapeHTML(result.parentPath)}</span>`
                  : ""
              }
              ${
                result.code
                  ? `<span class="item-code">${escapeHTML(result.code)}</span>`
                  : ""
              }
            </span>
            <span class="search-result-meta">
              <span class="status-badge ${getStatusClass(result.status)}">${escapeHTML(result.status)}</span>
              <span class="progress-text">${result.progress}%</span>
            </span>
          </button>
          ${
            children.length
              ? `
                <button
                  type="button"
                  class="search-result-expand"
                  data-result-key="${escapeHTML(result.key)}"
                  aria-expanded="${isExpanded}"
                  aria-label="${isExpanded ? "Collapse" : "Expand"} ${escapeHTML(result.name)} children"
                  title="${isExpanded ? "Collapse" : "Expand"}"
                >
                  <span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
                </button>
              `
              : ""
          }
        </div>
        ${
          children.length && isExpanded
            ? `
              <div class="search-result-children" role="group">
                ${children.map(renderSearchResult).join("")}
              </div>
            `
            : ""
        }
      </div>
    `;
  }


  function renderSearchResults() {
    const resultsContainer = treeContent.querySelector("#stageSearchResults");
    if (!(resultsContainer instanceof HTMLElement)) return;

    if (!searchQuery.trim()) {
      resultsContainer.replaceChildren();
      return;
    }

    if (!treeLoaded) {
      resultsContainer.innerHTML = treeLoadError
        ? `
          <div class="search-state">
            <p>Unable to load project structure: ${escapeHTML(treeLoadError)}</p>
            <button type="button" id="retryTree">Try Again</button>
          </div>
        `
        : `<p class="search-state">Loading project structure...</p>`;
      return;
    }

    const results = getSearchResults();
    if (!results.length) {
      resultsContainer.innerHTML = `
        <p class="search-state">
          No stages, substages, or activities match your search.
        </p>
      `;
      return;
    }

    resultsContainer.innerHTML = results.map(renderSearchResult).join("");
  }


  function updateSearchView() {
    const input = treeContent.querySelector("#stageSearch");
    const clearButton = treeContent.querySelector("#clearStageSearch");
    const treeList = treeContent.querySelector("#stageTreeList");
    const results = treeContent.querySelector("#stageSearchResults");
    const hasQuery = Boolean(searchQuery.trim());

    if (input instanceof HTMLInputElement && input.value !== searchQuery) {
      input.value = searchQuery;
    }
    if (clearButton instanceof HTMLButtonElement) {
      clearButton.hidden = !hasQuery;
    }
    if (treeList instanceof HTMLElement) treeList.hidden = hasQuery;
    if (results instanceof HTMLElement) results.hidden = !hasQuery;

    renderSearchResults();
  }


  function renderTree(viewState = { expanded: new Set() }) {
    const treeMarkup = stageTree.length
      ? `
          <div class="tree-list" role="tree">
            ${stageTree.map((stage) => renderStage(stage)).join("")}
          </div>
        `
      : `
          <div class="empty-state">
            <span class="material-symbols-rounded">
              account_tree
            </span>
            <h3>No stages found</h3>
            <p>
              This project does not have any
              top-level stages yet.
            </p>
          </div>
        `;

    treeContent.innerHTML = `
      ${renderSearchBar()}
      <div
        class="tree-scroll-area"
        id="stageTreeList"
        ${searchQuery.trim() ? "hidden" : ""}
      >
        ${treeMarkup}
      </div>
      <div
        class="search-results"
        id="stageSearchResults"
        role="region"
        aria-label="Search results"
        ${searchQuery.trim() ? "" : "hidden"}
      >
      </div>
    `;

    restoreTreeState(viewState);
    restoreFocusedItem();
    updateSearchView();
  }


  function restoreTreeState(viewState) {
    treeContainer.querySelectorAll(".stage-node").forEach((node) => {
      const stageId = node.dataset.stageId;
      const expanded = Boolean(stageId && viewState.expanded.has(stageId));
      setStageExpanded(node, expanded);
    });
  }


  function updateFocusedDisplay() {
    const itemName = focusedItem?.name || "Project Structure";
    const notes = {
      stage: "You are viewing the details for this stage.",
      substage: "You are viewing the details for this substage.",
      activity: "You are viewing the details for this activity.",
    };

    focusedItemName.textContent = itemName;
    focusedItemNote.textContent = focusedItem
      ? notes[focusedItem.type]
      : "Select a stage, substage, or activity to view its details.";

    treeContainer
      .querySelectorAll(".stage-row, .activity-item")
      .forEach((item) => {
        item.classList.remove("is-focused");
        item.setAttribute("aria-selected", "false");
      });

    if (!focusedItem?.id) return;

    const selector =
      focusedItem.type === "activity"
        ? ".activity-item"
        : ".stage-row";
    const selectedItem = [...treeContainer.querySelectorAll(selector)].find(
      (item) => {
        if (item.getAttribute("data-id") !== focusedItem.id) return false;
        return focusedItem.type === "activity"
          ? item.getAttribute("data-type") === "activity"
          : item.closest(".stage-node")?.getAttribute("data-type") === focusedItem.type;
      }
    );

    selectedItem?.classList.add("is-focused");
    selectedItem?.setAttribute("aria-selected", "true");
  }


  /**
   * @param {FocusedItem|null} item
   */
  function dispatchFocusedEvent(item) {
    if (!item?.id) return;

    if (item.type === "activity") {
      treeContainer.dispatchEvent(
        new CustomEvent("activity-selected", {
          bubbles: true,
          detail: { activityId: item.id },
        })
      );
      return;
    }

    treeContainer.dispatchEvent(
      new CustomEvent("stage-selected", {
        bubbles: true,
        detail: { stageId: item.id },
      })
    );
  }


  /**
   * @param {FocusedItem["type"]} type
   * @param {unknown} id
   * @param {string} name
   */
  function focusItem(type, id, name) {
    focusedItem = {
      type,
      id: id == null || id === "" ? null : String(id),
      name: name || (type === "activity" ? "Unnamed Activity" : "Unnamed Stage"),
    };
    updateFocusedDisplay();
    dispatchFocusedEvent(focusedItem);
  }


  /**
   * @returns {FocusedItem|null}
   */
  function findFocusedItem() {
    if (!focusedItem?.id) return null;

    /**
     * @param {TreeItem} stage
     * @param {boolean} isSubstage
     * @returns {FocusedItem|null}
     */
    function findStage(stage, isSubstage) {
      if (
        focusedItem.type !== "activity" &&
        String(getId(stage)) === focusedItem.id &&
        (isSubstage ? "substage" : "stage") === focusedItem.type
      ) {
        return {
          type: isSubstage ? "substage" : "stage",
          id: focusedItem.id,
          name: stage.name || "Unnamed Stage",
        };
      }

      for (const activity of stage.activities || []) {
        if (
          focusedItem.type === "activity" &&
          String(getId(activity)) === focusedItem.id
        ) {
          return {
            type: "activity",
            id: focusedItem.id,
            name: activity.name || "Unnamed Activity",
          };
        }
      }

      for (const substage of stage.substages || []) {
        const match = findStage(substage, true);
        if (match) return match;
      }

      return null;
    }

    for (const stage of stageTree) {
      const match = findStage(stage, false);
      if (match) return match;
    }

    return null;
  }


  function restoreFocusedItem() {
    if (!focusedItem) {
      updateFocusedDisplay();
      return;
    }

    const restoredItem = findFocusedItem();
    if (!restoredItem) {
      focusedItem = null;
      updateFocusedDisplay();
      return;
    }

    focusedItem = restoredItem;
    updateFocusedDisplay();
    dispatchFocusedEvent(focusedItem);
  }


  /**
   * @param {Element|null} stageNode
   * @param {boolean} expanded
   */
  function setStageExpanded(stageNode, expanded) {
    const children = stageNode?.querySelector(":scope > .stage-children");
    const button = stageNode?.querySelector(":scope > .stage-row .expand-button");
    if (!children || !(button instanceof HTMLButtonElement)) return;

    children.classList.toggle("is-open", expanded);
    button.setAttribute("aria-expanded", String(expanded));
    button.setAttribute(
      "aria-label",
      `${expanded ? "Collapse" : "Expand"} ${
        stageNode.querySelector(":scope > .stage-row .stage-name")?.textContent ||
        "stage"
      }`
    );
    button.title = expanded ? "Collapse" : "Expand";
  }


  /**
   * @param {HTMLElement} row
   */
  function selectStageRow(row) {
    const stageNode = row.closest(".stage-node");
    if (!stageNode) return;

    const type =
      stageNode.getAttribute("data-type") === "substage"
        ? "substage"
        : "stage";
    const name =
      row.querySelector(".stage-name")?.textContent?.trim() ||
      "Unnamed Stage";

    focusItem(type, stageNode.getAttribute("data-stage-id"), name);
    const children = stageNode.querySelector(":scope > .stage-children");
    if (children) {
      const button = row.querySelector(".expand-button");
      setStageExpanded(
        stageNode,
        button?.getAttribute("aria-expanded") !== "true"
      );
    }
  }


  /**
   * @param {HTMLElement} item
   */
  function selectActivity(item) {
    const name =
      item.querySelector(".item-name")?.textContent?.trim() ||
      "Unnamed Activity";
    focusItem("activity", item.dataset.id, name);
  }


  /*
   * ------------------------------------------------------------
   * TREE EVENTS
   * ------------------------------------------------------------
   */

  function attachTreeEvents() {
    treeSection.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.id !== "stageSearch") {
        return;
      }

      searchQuery = target.value;
      updateSearchView();
    });

    treeSection.addEventListener("click", (event) => {
      const target = event.target instanceof HTMLElement ? event.target : null;
      if (!target) return;

      if (target.closest("#clearStageSearch")) {
        searchQuery = "";
        updateSearchView();
        const searchInput = treeContent.querySelector("#stageSearch");
        if (searchInput instanceof HTMLInputElement) searchInput.focus();
        return;
      }

      const searchResultExpand = target.closest(".search-result-expand");
      if (searchResultExpand instanceof HTMLButtonElement) {
        const resultKey = searchResultExpand.dataset.resultKey;
        if (!resultKey) return;

        if (expandedSearchResults.has(resultKey)) {
          expandedSearchResults.delete(resultKey);
        } else {
          expandedSearchResults.add(resultKey);
        }

        renderSearchResults();
        const updatedButton = Array.from(
          treeContent.querySelectorAll(".search-result-expand")
        ).find(
          (button) =>
            button instanceof HTMLButtonElement &&
            button.dataset.resultKey === resultKey
        );
        if (updatedButton instanceof HTMLButtonElement) updatedButton.focus();
        return;
      }

      const searchResult = target.closest(".search-result");
      if (searchResult instanceof HTMLElement) {
        const type = searchResult.dataset.type;
        if (type !== "stage" && type !== "substage" && type !== "activity") {
          return;
        }
        focusItem(
          type,
          searchResult.dataset.id,
          searchResult.querySelector(".search-result-name")?.textContent?.trim() || ""
        );
        updateSearchView();
        return;
      }

      const retryButton = target.closest("#retryTree");
      if (retryButton) {
        void loadTree();
        return;
      }

      const expandButton = target.closest(".expand-button");
      if (expandButton) {
        const stageNode = expandButton.closest(".stage-node");
        setStageExpanded(
          stageNode,
          expandButton.getAttribute("aria-expanded") !== "true"
        );
        return;
      }

      const stageRow = target.closest(".stage-row");
      if (stageRow instanceof HTMLElement) {
        selectStageRow(stageRow);
        return;
      }

      const activityItem = target.closest(".activity-item");
      if (activityItem instanceof HTMLElement) selectActivity(activityItem);
    });

    treeSection.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      const target = event.target instanceof HTMLElement ? event.target : null;
      if (!target || target.closest(".expand-button")) return;

      const stageRow = target.closest(".stage-row");
      const activityItem = target.closest(".activity-item");
      if (!(stageRow instanceof HTMLElement) && !(activityItem instanceof HTMLElement)) {
        return;
      }

      event.preventDefault();
      if (stageRow instanceof HTMLElement) selectStageRow(stageRow);
      else if (activityItem instanceof HTMLElement) selectActivity(activityItem);
    });
  }


  /*
   * ------------------------------------------------------------
   * UI STATES
   * ------------------------------------------------------------
   */

  function showLoading() {
    treeContent.innerHTML = `
      ${renderSearchBar()}
      <div class="tree-scroll-area tree-state-area">
        <div class="tree-loading">
          <span class="spinner"></span>
          <span>Loading project structure...</span>
        </div>
      </div>
      <div class="search-results" id="stageSearchResults" role="region" aria-label="Search results" hidden></div>
    `;
    updateSearchView();
  }


  /**
   * @param {string} message
   */
  function showError(message) {
    treeContent.innerHTML = `
      ${renderSearchBar()}
      <div class="tree-scroll-area tree-state-area">
        <div class="tree-error">
        <span class="material-symbols-rounded">
          error
        </span>
        <div>
          <strong>
            Unable to load project structure
          </strong>
          <p>
            ${escapeHTML(message)}
          </p>
          <button
            type="button"
            id="retryTree"
          >
            Try Again
          </button>
        </div>
        </div>
      </div>
      <div class="search-results" id="stageSearchResults" role="region" aria-label="Search results" hidden></div>
    `;
    updateSearchView();
  }


  /*
   * ------------------------------------------------------------
   * INITIALISE
   * ------------------------------------------------------------
   */

   attachTreeEvents();
   loadTree();
</script>


