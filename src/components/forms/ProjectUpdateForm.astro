---
const { projectId } = Astro.props;
---

<section class="project-update-form">
  <div class="project-update-form__header">
    <h2>Project Update</h2>
    <p>Project update tracking is available once the form implementation is connected.</p>
  </div>
</section>

<style>
  .project-update-form {
    width: 100%;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
  }

  .project-update-form__header h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .project-update-form__header p {
    margin: 0;
    color: #4b5563;
  }
</style>
